{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "real-firebase/app": [
        "./node_modules/firebase/app/dist/app/index.d.ts"
      ],
      "real-firebase/auth": [
        "./node_modules/firebase/auth/dist/auth/index.d.ts"
      ],
      "firebase/firestore": [
        "./src/lib/supabaseDb.ts"
      ],
      "firebase/auth": [
        "./src/lib/supabaseAuth.ts"
      ],
      "firebase/app": [
        "./src/lib/supabaseApp.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
